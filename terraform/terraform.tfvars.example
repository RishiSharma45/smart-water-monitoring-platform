# ==============================================================================
# Smart Water Monitoring Platform - Example Terraform Variables
# ==============================================================================
# Copy this file to `terraform.tfvars` to customize settings for your deployment.
# NEVER commit `terraform.tfvars` or credentials to version control.
# ==============================================================================

aws_region       = "us-east-1"
project_name     = "smart-water-monitor"
instance_type    = "t3.micro"
key_name         = "ubuntu-key"
allowed_ssh_cidr = "128.185.168.200/32"
root_volume_size = 25
