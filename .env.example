DB_USER=admin
DB_PASSWORD=change-this-password
DB_NAME=waterdb

EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@example.com
SMTP_PASSWORD=change-this-smtp-password
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=team@example.com

SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/example

GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=smtp.example.com:587
GRAFANA_SMTP_USER=alerts@example.com
GRAFANA_SMTP_PASSWORD=change-this-grafana-smtp-password
GRAFANA_SMTP_FROM_ADDRESS=alerts@example.com

DOCKER_REGISTRY=your-dockerhub-username
IMAGE_TAG=latest
