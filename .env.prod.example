# ==============================================================================
# Smart Water Monitoring Platform - Production Environment Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` on your EC2 production host.
# 2. Replace the placeholder values with your secure secrets.
# 3. DO NOT commit the populated `.env` file to Git (it is ignored by .gitignore).
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_USER=wateradmin
DB_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_DB_PASSWORD
DB_NAME=waterdb

# Application Image Tag
SMART_WATER_IMAGE_TAG=prod

# Notification Settings (Optional - disabled by default)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
