{
  "uid": "smart-water-postgresql",
  "title": "PostgreSQL Metrics",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Exporter Status",
      "type": "stat",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up{job=\"postgres-exporter\"} or vector(0)",
          "legendFormat": "up",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 2,
      "title": "Database Size",
      "type": "stat",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"waterdb\"} or vector(0)",
          "legendFormat": "bytes",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 3,
      "title": "Active Connections",
      "type": "stat",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"waterdb\"} or vector(0)",
          "legendFormat": "connections",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 4,
      "title": "Rollback Rate",
      "type": "stat",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"waterdb\"}[5m]) or vector(0)",
          "legendFormat": "rollbacks/sec",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    }
  ]
}
